# HerAccess Environment Configuration

# Application Mode
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (defaults to SQLite for local development)
DATABASE_URL=sqlite:///./heraccess.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heraccess

# LLM Providers (Optional for Natural Language Intent Parsing, Deterministic Rule Fallback included)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Bright Data Configuration (Collector integration)
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=
BRIGHT_DATA_USE_FIXTURES=true
BRIGHT_DATA_FIXTURES_DIR=./fixtures

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
